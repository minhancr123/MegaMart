# ==== MegaMart client - biến môi trường ====
# Copy thành .env.local (dev). Lưu ý: NEXT_PUBLIC_* bị bake cứng vào JS
# lúc `next build`, đổi giá trị là phải build lại image (CD làm tự động).

# Origin của web public (KHÔNG kèm /api — client tự thêm).
# Dev local:
NEXT_PUBLIC_API_URL=http://localhost:3001
# Production (VD):
# NEXT_PUBLIC_API_URL=https://shop.cuaban.com

# Map / địa chỉ
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
# Google OAuth Client ID cho nút Đăng nhập bằng Google ở /auth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Cloudinary (upload phía client)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# SePay VietQR hiển thị cho khách chuyển khoản
NEXT_PUBLIC_SEPAY_BANK=
NEXT_PUBLIC_SEPAY_ACCOUNT_NO=
NEXT_PUBLIC_SEPAY_ACCOUNT_NAME=
NEXT_PUBLIC_SEPAY_PAYMENT_WINDOW_MINUTES=30

# Tracking (để trống = tắt)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# JWT_SECRET ở đây chỉ dùng cho middleware Edge local (đồng bộ với server).
JWT_SECRET=doi-giong-server
