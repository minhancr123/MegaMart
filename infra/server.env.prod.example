# Template file server/.env.prod TRÊN EC2 (~/megamart/server/.env.prod, chmod 600).
# KHÔNG commit file thật. Copy từ server/.env.example rồi điền giá trị production.
# Checklist trước deploy đầu tiên:
#  [ ] DATABASE_URL trỏ RDS (khuyên dùng) hoặc postgres container (profile localdb)
#  [ ] JWT_SECRET random mới, KHÁC môi trường dev
#  [ ] FRONTEND_URL + VNPAY_RETURN_URL + SEPAY_WEBHOOK_URL = domain/IP public thật
#  [ ] Đã chạy `npx prisma migrate deploy` ít nhất 1 lần (CD tự chạy mỗi deploy)

PORT=3001
NODE_ENV=production
FRONTEND_URL=https://shop.cuaban.com
JWT_SECRET=RANDOM-32-CHARS-MIN-PROD-ONLY-CHANGE-ME
JWT_EXPIRES_IN=7d

# Khuyên dùng RDS (xem DEPLOY.md bước 3). VD:
# DATABASE_URL=postgresql://megamart:MAT-KHAU-MANH@megamart-db.xxxxx.ap-southeast-1.rds.amazonaws.com:5432/megamart?schema=public
# Local fallback (compose --profile localdb):
# DATABASE_URL=postgresql://megamart:MAT-KHAU-MANH@postgres:5432/megamart?schema=public
DATABASE_URL=postgresql://user:password@host:5432/megamart?schema=public
DIRECT_URL=postgresql://user:password@host:5432/megamart?schema=public

GOOGLE_AI_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
# Chatbot: key Zenmux, nhiều key cách nhau dấu phẩy để xoay vòng.
# Rỗng => chatbot dùng fallback canned response.
ZENMUX_API_KEYS=
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
AI_MODEL=
JOB_FLASH_SALE=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=megamart

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# GHN production: đổi sang https://online-gateway.ghn.vn + token/shop thật
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=1444
GHN_STATUS_NAMES=
GHN_WEBHOOK_SECRET=

# VNPay production: URL + TMN code + hash secret thật
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://shop.cuaban.com/payment/vnpay-return

SEPAY_API_BASE_URL=https://userapi.sepay.vn
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_REFUND_ENABLED=false
SEPAY_REFUND_MOCK_SUCCESS=false
SEPAY_WEBHOOK_URL=https://shop.cuaban.com/api/payment/webhook
