{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "zenmux": {
      "baseURL": "https://zenmux.ai/api/v1",
      "apiKey": "{env:ZENMUX_API_KEY_1}"
    },
    "9router": {
      "baseURL": "https://api.9router.ai/v1",
      "apiKey": "{env:ZENMUX_API_KEY_1}"
    },
    "9router_acc2": {
      "baseURL": "https://api.9router.ai/v1",
      "apiKey": "{env:ZENMUX_API_KEY_2}"
    },
    "9router_acc3": {
      "baseURL": "https://api.9router.ai/v1",
      "apiKey": "{env:ZENMUX_API_KEY_3}"
    }
  },
  "model": "9router/code-daily",
  "agent": {
    "plan": {
      "model": "9router_acc2/code-daily"
    },
    "explore": {
      "model": "9router_acc3/code-daily"
    }
  },
  "mcp": {
    "graft": {
      "type": "local",
      "command": [
        "graft",
        "mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "playwright-mcp"
      ],
      "enabled": true
    }
  }
}
