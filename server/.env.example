# ==== MegaMart server - biến môi trường ====
# Copy thành .env (dev local) hoặc server/.env.prod (trên EC2, chmod 600).
# KHÔNG bao giờ commit file chứa giá trị thật.

# ---- App ----
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://shop.cuaban.com
JWT_SECRET=doi-chuoi-nga-nhien-dai-32-ky-tu-tro-len
JWT_EXPIRES_IN=7d
# Google OAuth (nút Đăng nhập bằng Google) — lấy ở Google Cloud Console
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# ---- Database (Prisma Postgres / RDS / local) ----
DATABASE_URL=postgresql://user:password@host:5432/megamart?schema=public
DIRECT_URL=postgresql://user:password@host:5432/megamart?schema=public

# ---- AI ----
GOOGLE_AI_KEY=thay-bang-key-that
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Chatbot (server/src/modules/ai/ai.service.ts) đọc key từ đây, KHÔNG hardcode.
# Nhiều key cách nhau dấu phẩy -> xoay vòng round-robin. Rỗng => chatbot dùng
# fallback canned response (không gọi LLM, app vẫn chạy).
ZENMUX_API_KEYS=
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
# Model chat. Để trống thì dùng openai/gpt-6-luna.
AI_MODEL=

# ---- Background jobs ----
JOB_FLASH_SALE=false
INNGEST_EVENT_KEY=thay-bang-key-that
INNGEST_SIGNING_KEY=thay-bang-key-that

# ---- Cloudinary (upload ảnh) ----
CLOUDINARY_CLOUD_NAME=thay-bang-ten-cloud
CLOUDINARY_API_KEY=thay-bang-key-that
CLOUDINARY_API_SECRET=thay-bang-secret-that
CLOUDINARY_UPLOAD_PRESET=megamart

# ---- SMTP (gửi mail) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=thay-bang-email
SMTP_PASS=thay-bang-app-password

# ---- GHN (vận chuyển) ----
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=thay-bang-token-that
GHN_SHOP_ID=thay-bang-shop-id
GHN_FROM_DISTRICT_ID=1444
GHN_STATUS_NAMES=
GHN_WEBHOOK_SECRET=thay-bang-secret-that
# false (mặc định): webhook GHN chỉ ghi timeline, trạng thái đơn do shipper nhà đẩy.
# true: cho GHN tự đẩy order.status (hành vi cũ).
GHN_WEBHOOK_STATUS_SYNC=false

# ---- VNPay ----
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=thay-bang-ma-that
VNPAY_HASH_SECRET=thay-bang-secret-that
VNPAY_RETURN_URL=https://shop.cuaban.com/payment/vnpay-return

# ---- SePay (webhook chuyển khoản) ----
SEPAY_API_BASE_URL=https://userapi.sepay.vn
SEPAY_API_KEY=thay-bang-api-key-that
SEPAY_WEBHOOK_SECRET=thay-bang-webhook-secret-that
SEPAY_REFUND_ENABLED=false
SEPAY_REFUND_MOCK_SUCCESS=false
SEPAY_WEBHOOK_URL=https://shop.cuaban.com/api/payment/webhook
# Dev: cloudflared cho URL random (npm run tunnel), localtunnel subdomain cố định (npm run tunnel:fixed)
TUNNEL_SUBDOMAIN=megamart-sepay-webhook
